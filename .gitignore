# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.env
.venv
venv/
ENV/

# Jupyter Notebooks
.ipynb_checkpoints/

# Data files
*.npy
*.xlsx
*.h5
*.parquet
*.pkl
*.log

# Large tabular datasets should stay out of git. Thesis-facing CSV outputs
# under outputs/explainability are intentionally allowed unless covered by
# a more specific generated-output rule below.
data/**/*.csv
outputs/**/*.csv
!outputs/explainability/
!outputs/explainability/*.csv

# Outputs (generated)
outputs/models/
outputs/reports/
outputs/splits/

# Keep small, thesis-critical JSON manifests for reproducibility
outputs/preprocess/*
!outputs/preprocess/feature_names.json
!outputs/preprocess/feature_schema.json

outputs/processed/*
!outputs/processed/feature_order.json

# Stage 2 outputs are generated (figures/summaries) and can be reproduced
outputs/stage2/

# Stage 3 (ZK): keep artifacts and test vectors; ignore generated build/proof outputs
stage3_zk/outputs/
stage3_zk/circuits/**/build/

# ZK generated artifacts that should stay out of source control
*.r1cs
*.sym
*.wtns
*.zkey
*.ptau
proof.json
public.json
witness.wtns
*_js/

# Ignore timestamped evidence runs; keep stable LATEST report files
stage3_zk/reports/repro_run_*.md
stage3_zk/reports/repro_run_*.json
!stage3_zk/reports/LATEST_REPRO_REPORT.md
!stage3_zk/reports/LATEST_REPRO_REPORT.json

# OS
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Reports (keep markdown, ignore temp)
*.tmp
*.bak

# Node
node_modules/

# Ignore raw data
/data/raw/

# Ignore processed data
/data/processed/

# Ignore large files
*.zip
*.tar.gz
*.7z
*.rar

# Ignore secrets
*.env
secrets.json
